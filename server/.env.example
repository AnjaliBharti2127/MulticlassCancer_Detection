NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/patho

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://multiclass-cancer-detection-7jk56kv5d-anjali-db5d.vercel.app

JSON_BODY_LIMIT=1mb
MAX_FILE_SIZE_MB=5
MIN_IMAGE_DIMENSION_PX=64
MAX_IMAGE_DIMENSION_PX=20000
MAX_IMAGE_PIXELS=100000000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

LOG_LEVEL=info

# FastAPI ML inference service (Block 6/7)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=30000
