{
  "name": "patho-backend",
  "version": "1.0.0",
  "description": "Backend API for Patho - multiclass cancer detection web app (student project)",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "kill-port 5000 && tsx watch src/server.ts",
    "build": "tsc",
