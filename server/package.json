    "express-rate-limit": "^7.4.1",
    "form-data": "^4.0.6",
    "helmet": "^8.0.0",
    "image-size": "^2.0.2",
    "mongodb": "^7.5.0",
    "mongoose": "^8.8.3",
    "multer": "^1.4.5-lts.1",
